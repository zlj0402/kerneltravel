# Claude Code - 跨平台同步记忆
.claude/*

# 取消忽略目录本身
!.claude/skills/
# 取消忽略具体内容
!.claude/skills/**

!.claude/projects/*/memory/
!.claude/projects/*/MEMORY.md
!.claude/settings.local.json.template
!.claude/README.md
# Ignore large conversation history files
.claude/**/*.jsonl 

.vscode/*

**/cmake/**/build/**
**/cmake/**/output/**